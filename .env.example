# Farol configuration reference.
# Export these in your shell or process manager. The built-in start script
# does not load a .env file automatically.

# HTTP
PORT=4400
HOST=127.0.0.1

# Persistence
FAROL_DB_PATH=./data/farol.db

# Demo pacing. Set to 0 for tests or CI.
FAROL_STEP_DELAY_MS=150

# Concurrency and rate limits
FAROL_MAX_CONCURRENT_RUNS=2
FAROL_SEARCHES_PER_MINUTE=6
FAROL_WRITES_PER_MINUTE=90

# Optional team authentication. When FAROL_ACCESS_PASSWORD is set,
# /api/* (except the private client portal) requires HTTP Basic auth.
# Use at least 8 characters. Client portal links remain token-based.
FAROL_ACCESS_USER=farol
FAROL_ACCESS_PASSWORD=

# Logging: debug | info | warn | error
FAROL_LOG_LEVEL=info

# Demo mode only. This build does not contact external property sites.
# A production adapter must use licensed feeds or permitted APIs and respect
# each source's terms and robots directives.

# ---------------------------------------------------------------------------
# Live market
# ---------------------------------------------------------------------------
# The listing-first agent can fetch public Imovirtual search results when the
# user selects Live market. No API key is required for that source.
# Confirm Imovirtual's terms for your use. To add other providers or licensed
# feeds, implement the provider contract and respect robots/terms/rate limits.
# Never bypass logins, anti-bot controls or portal restrictions.
# Optional staging/test override (defaults to https://www.imovirtual.com):
# FAROL_LIVE_BASE_URL=http://127.0.0.1:9
