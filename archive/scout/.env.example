# ── Scout configuration ────────────────────────────────────────────────────────
# Copy to .env only if you use a process manager/loader that reads it.
# The built-in start script does not require a dotenv package; export variables
# in your shell (or Docker environment) instead, e.g. `SCOUT_MODE=demo npm start`.

# demo  – deterministic simulated market, built around the PBoR portfolio (no keys)
# live  – real Tavily web search + page extraction (requires TAVILY_API_KEY)
# auto  – live when TAVILY_API_KEY is present, otherwise demo
SCOUT_MODE=auto

PORT=4321
HOST=127.0.0.1

# Where SQLite and demo data live
SCOUT_DB_PATH=./data/scout.db

# Pace of the simulated agent (milliseconds between events). Set 0 for tests.
SCOUT_STEP_DELAY_MS=190

# Run limits (protection for the public deployment)
SCOUT_MAX_CONCURRENT_RUNS=3
SCOUT_RUNS_PER_MINUTE=8

# Optional HTTP Basic Auth. Leave blank for local demo. When set, everything
# except /api/health requires credentials. Use behind TLS in production.
SCOUT_ACCESS_USER=scout
SCOUT_ACCESS_PASSWORD=

# ── Live web search ───────────────────────────────────────────────────────────
# Tavily is used for discovery and per-portal site: queries.
TAVILY_API_KEY=

# Optional OpenAI-compatible endpoint for high-precision extraction from pages
# that do not expose JSON-LD structured data. Leave blank to use regex heuristics.
SCOUT_LLM_URL=
SCOUT_LLM_KEY=
SCOUT_LLM_MODEL=

# Identifies Scout when fetching public pages (set a real contact URL in prod).
SCOUT_USER_AGENT=ScoutPriceBot/1.0 (+https://propertybuyorrent.com)

# Fixed FX rates into EUR. Override for production with a treasury feed.
SCOUT_FX='{"EUR":1,"GBP":1.17,"USD":0.92}'
